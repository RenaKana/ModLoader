--- /dev/null
+++ b/include/strata/program/decode_boundary.hpp
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+namespace strata::program {
+
+// Outputs[i] is predicted by input row i. The last returned output is not
+// consumed yet; a keep of i + 1 commits inputs [0, i], not that output itself.
+// Callers have a nonempty accepted window and at least one output left.
+inline int decode_window_keep(bool exact_stop, const int32_t* outputs, int accepted_count,
+                              int first_output, int64_t remaining, const std::vector<int64_t>& eos_ids) {
+    if (!exact_stop) return accepted_count;
+    const int end = first_output + static_cast<int>(std::min<int64_t>(accepted_count - first_output, remaining));
+    for (int i = first_output; i < end; ++i)
+        if (std::find(eos_ids.begin(), eos_ids.end(), static_cast<int64_t>(outputs[i])) != eos_ids.end()) return i + 1;
+    return end;
+}
+
+} // namespace strata::program
--- /dev/null
+++ b/src/program/decode_boundary_test.cpp
@@ -0,0 +1,55 @@
+#include "strata/program/decode_boundary.hpp"
+
+#include <algorithm>
+#include <cstdio>
+#include <vector>
+
+int main() {
+    using strata::program::decode_window_keep;
+    const std::vector<int64_t> stops{9, 99};
+    int checks = 0;
+    auto check = [&](const std::vector<int32_t>& out, int count, int first, int64_t remaining, int expected) {
+        ++checks;
+        const int kept = decode_window_keep(true, out.data(), count, first, remaining, stops);
+        if (kept != expected || decode_window_keep(false, out.data(), count, first, remaining, stops) != count) {
+            std::fprintf(stderr, "keep=%d expected=%d count=%d first=%d remaining=%lld\n",
+                         kept, expected, count, first, (long long) remaining);
+            return false;
+        }
+        // A next prompt consists of the old input row, returned outputs and a new
+        // message. Only its exact prefix may remain in the recurrent state.
+        std::vector<int32_t> inputs{7}, next{7};
+        inputs.insert(inputs.end(), out.begin(), out.begin() + count - 1);
+        next.insert(next.end(), out.begin(), out.begin() + expected);
+        next.push_back(88);
+        return std::equal(inputs.begin(), inputs.begin() + kept, next.begin());
+    };
+    if (!check({9, 10, 11, 12}, 4, 0, 20, 1) ||
+        !check({10, 99, 12, 13}, 4, 0, 20, 2) ||
+        !check({10, 11, 12, 9}, 4, 0, 20, 4) ||
+        !check({10, 11, 12, 13}, 4, 0, 1, 1) ||
+        !check({10, 11, 12, 13}, 4, 0, 3, 3) ||
+        !check({10, 11, 12, 13}, 4, 0, 1000000, 4) ||
+        !check({10, 11, 9, 13}, 2, 0, 20, 2) ||
+        !check({9, 10, 11, 99}, 4, 3, 1, 4) ||
+        !check({9}, 1, 0, 1, 1)) return 1;
+    // Cover every accepted-prefix/length/EOS position, including the merged
+    // first window whose earlier rows are prompt predictions, not output.
+    for (int count = 1; count <= 8; ++count) {
+        for (int first : {0, count - 1}) {
+            for (int remaining = 1; remaining <= count + 1; ++remaining) {
+                for (int stop = -1; stop < count; ++stop) {
+                    std::vector<int32_t> out(count, 10);
+                    if (stop >= 0) out[stop] = 9;
+                    int expected = first;
+                    for (int i = first; i < count && i - first < remaining; ++i) {
+                        expected = i + 1;
+                        if (out[i] == 9) break;
+                    }
+                    if (!check(out, count, first, remaining, expected)) return 1;
+                }
+            }
+        }
+    }
+    std::printf("decode_boundary_test OK (%d checks)\n", checks);
+}
